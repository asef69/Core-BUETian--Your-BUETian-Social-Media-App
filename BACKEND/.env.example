# Copy to .env for local development. In production (Vercel) set these as
# project environment variables instead.

DEBUG=True
# REQUIRED when DEBUG is off: JWTs are signed with it. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
# Defaults to localhost + *.vercel.app + *.onrender.com; add custom domains here.
ALLOWED_HOSTS=*
# Login / register rate limit per client IP (DRF format), and proxies in front of the app.
# AUTH_THROTTLE_RATE=20/min
# NUM_PROXIES=1
# Expose /swagger/ and /redoc/ publicly in production (off by default, staff-only).
# SWAGGER_PUBLIC=false
# Comma-separated frontend origins; leave empty to allow all (dev only).
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# --- Supabase PostgreSQL ---------------------------------------------------
# Use the *Connection pooler* values from Supabase -> Project Settings ->
# Database (Transaction mode, port 6543). The direct db.<ref>.supabase.co host
# is IPv6-only and cannot be reached from Vercel.
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=your-database-password
DB_HOST=aws-<n>-<region>.pooler.supabase.com
DB_PORT=6543
DB_SSLMODE=require

# --- Cloudinary (image & video storage) ------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# ...or a single variable instead of the three above:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=buetian

# Optional: share WebSocket chat events across processes
# REDIS_URL=redis://localhost:6379/0

# --- Abuse protection -------------------------------------------------------
# Per-user limits for write endpoints (reads are never limited). Format: <n>/min.
# THROTTLE_POSTS=30/min  THROTTLE_COMMENTS=60/min  THROTTLE_CHAT=120/min  THROTTLE_CONTACT=10/min ...
# Failed logins per account before a temporary lockout, and its length in seconds.
# LOGIN_MAX_FAILURES=8
# LOGIN_LOCKOUT_SECONDS=900
# Rate limits and lockouts are counted in memory per process; set REDIS_URL to share them.
# Hosts whose https URLs may be stored as media links (comma separated).
# ALLOWED_MEDIA_HOSTS=res.cloudinary.com
# Access token lifetime in minutes (default one day) and Django admin switch.
# ACCESS_TOKEN_MINUTES=1440
# ADMIN_ENABLED=false
