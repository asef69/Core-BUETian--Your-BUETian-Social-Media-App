# Copy to .env.local for local development, or set these in the Vercel project.

# Django API base URL (include /api)
VITE_API_URL=http://localhost:8000/api

# Set to "false" on hosts without WebSocket support (Vercel).
# Chat then uses REST + polling instead of /ws/chat/.
VITE_ENABLE_WEBSOCKET=true

# Optional: explicit WebSocket origin, e.g. wss://api.example.com
# VITE_WS_URL=
